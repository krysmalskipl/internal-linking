# Copy to .env and put your keys in it.

# OpenRouter - https://openrouter.ai/settings/keys
# Needed for the page embeddings, and for Jev when TYPESAFE_API_KEY is empty.
OPENROUTER_API_KEY=

# TypeSafe - https://console.typesafe.ai
# Optional: with a key here Jev is called on TypeSafe's own API; empty = Jev through OpenRouter.
TYPESAFE_API_KEY=

# Optional:
# TYPESAFE_MODEL=jev-1.13.0
# JEV_MODEL=typesafe/jev-1.13
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_DIMENSIONS=768
